# ── Database ──────────────────────────────────────────────────────────────
# SQLite for local/v1. For Postgres on Vercel:
#   1. change provider to "postgresql" in prisma/schema.prisma
#   2. set DATABASE_URL to your Postgres connection string
DATABASE_URL="file:./dev.db"

# ── Site URL (used for sitemap, OG, canonical) ────────────────────────────
# TODO(owner): set the real production domain once purchased
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin (HTTP Basic Auth for /admin) ────────────────────────────────────
# TODO(owner): choose a strong username + password before deploying
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-strong-password"

# ── Email (booking notifications) ─────────────────────────────────────────
# Option A (recommended): Resend — https://resend.com — set RESEND_API_KEY.
# Option B (fallback): plain SMTP — set the SMTP_* vars instead.
# If neither is configured, bookings still save; emails are skipped and logged.
RESEND_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Address bookings are sent FROM (must be a verified sender on Resend/SMTP)
EMAIL_FROM="Aulon Detailing <bookings@example.com>"
# TODO(owner): the owner inbox that receives new booking notifications
OWNER_EMAIL="owner@example.com"

# ── Stripe (booking deposit) ──────────────────────────────────────────────
# If left empty, payments are DISABLED and bookings work without a deposit.
# 1. Create an account at https://stripe.com and copy the secret key
# 2. Create a webhook endpoint pointing to https://YOUR-DOMAIN/api/stripe/webhook
#    listening for "checkout.session.completed", and copy its signing secret
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
