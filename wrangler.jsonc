{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aulon-detailing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aulon-detailing",
      "database_id": "46ea7a83-c56d-4076-a436-4c956796c222",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Non-secret vars. Secrets (ADMIN_PASSWORD, RESEND_API_KEY, STRIPE keys,
    // OWNER_EMAIL, EMAIL_FROM, ADMIN_USER) are set with `wrangler secret put`.
    "NEXT_PUBLIC_SITE_URL": "https://aulondetailing.com"
  }
}
